[Unit]
Description=First boot user creation wizard
ConditionPathExists=!/var/lib/firstboot-user.done
After=systemd-user-sessions.service getty-pre.target
Before=display-manager.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/lib/firstboot-user/firstboot-user.sh

[Install]
WantedBy=graphical.target
